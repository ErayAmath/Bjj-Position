# Raw dataset (~200 MB) -> never commit. Leading slash: only the top-level data/,
# not frontend/data/ (which holds small derived exports).
/data/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Model checkpoints can get large; results/ (CSV/JSON/figures) IS committed.
checkpoints/
*.pt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code tooling config
.claude/
